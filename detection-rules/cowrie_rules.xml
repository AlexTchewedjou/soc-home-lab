<!--
  Custom Wazuh rules for Cowrie honeypot events.
  Cowrie writes JSON; Wazuh decodes it (log_format json) and these rules
  raise severity-rated, MITRE-mapped alerts.
  Place on the Wazuh manager at /var/ossec/etc/rules/cowrie_rules.xml
  Author: Alex Tchewedjou
-->
<group name="cowrie,honeypot,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie honeypot event</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Cowrie: Failed SSH/Telnet login from $(src_ip) [$(username)/$(password)]</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.success$</field>
    <description>Cowrie: SUCCESSFUL login - attacker got a shell from $(src_ip) [$(username)/$(password)]</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.command\.input$</field>
    <description>Cowrie: Attacker command from $(src_ip): $(input)</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <rule id="100104" level="12">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.session\.file_download$</field>
    <description>Cowrie: File download (possible malware) from $(src_ip) - url: $(url)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.session\.connect$</field>
    <description>Cowrie: New connection from $(src_ip)</description>
  </rule>

</group>
